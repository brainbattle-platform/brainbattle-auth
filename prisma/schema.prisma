generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  displayName   String?
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String // hash của refresh token hiện tại
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
